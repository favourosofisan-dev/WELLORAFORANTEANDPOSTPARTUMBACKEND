{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1",
      "service": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "/$1",
      "service": "frontend"
    }
  ]
}
